{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/oferta-formativa/",
        "http://localhost:8080/oferta-formativa/panificacion-industrial/",
        "http://localhost:8080/admision/",
        "http://localhost:8080/turnos-y-horarios/",
        "http://localhost:8080/servicios/",
        "http://localhost:8080/contacto/",
        "http://localhost:8080/privacidad/",
        "http://localhost:8080/accesibilidad/",
        "http://localhost:8080/nosotros/"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
