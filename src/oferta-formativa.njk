      <span class="program-name">{{ a.nombre }}</span>
      <span class="program-meta">Título a nombre de la Nación</span>
      <span class="program-arrow" aria-hidden="true">→</span>
    </a>
    {% endfor %}
  </nav>

  <h2>Programas de auxiliar técnico <span class="h2-aside">// 1 año</span></h2>
  <nav class="program-list auxiliares" aria-label="Programas de auxiliar técnico">
    {% for a in areas.items | filterBy('nivel', 'auxiliar-tecnico') %}
    <a class="program-row" href="/oferta-formativa/{{ a.id }}/">
      <span class="program-name">{{ a.nombre }}</span>
      <span class="program-meta">Certif. de auxiliar técnico</span>
      <span class="program-arrow" aria-hidden="true">→</span>
    </a>
    {% endfor %}
  </nav>

  <p class="card-caption">Programas más solicitados: Estilismo, Panificación Industrial, Cocina, Computación (su ubicación curricular se confirma con la institución) y Estampado de Prendas.</p>
