{
  "type": "object",
  "required": ["items"],
  "additionalProperties": true,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "source", "validated", "validated_by", "validated_at"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
          "nombre": { "type": "string", "minLength": 1 },
          
          
          "source": { "type": "string", "minLength": 1 },
          "validated": { "type": "boolean" },
          "validated_by": { "type": "string", "minLength": 1 },
          "validated_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
