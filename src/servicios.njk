<article>
  {% set ph_eyebrow = "SERVICIOS · COMUNIDAD" %}{% set ph_card_tag = "[ 4 ]" %}{% set ph_card_title = "Cuatro servicios abiertos" %}{% set ph_card_desc = "Certificación, bolsa de trabajo, emprendimiento y servicios a la comunidad." %}{% set ph_title = "Servicios" %}{% set ph_lead = "El CETPRO San Luis ofrece formación técnica y servicios abiertos a estudiantes, egresados y la comunidad." %}{% set ph_cta_text = "Consultar al CETPRO" %}{% set ph_cta_href = "/contacto/" %}
  {% include "page-hero.njk" %}
  <div class="wrap">

  <div class="cards">
    {% for s in servicios.items %}
    <article class="card" id="{{ s.id }}">
      <h2>{{ s.nombre }}</h2>
      <p>{{ s.descripcion }}</p>
      <p><strong>¿Cómo acceder?</strong> {{ s.como_acceder }}</p>
      <p><strong>Contacto:</strong> {{ s.contacto }}</p>
        </article>
    {% endfor %}
  </div>

  <p class="card-caption">Algunos servicios aún no tienen confirmación institucional pública en este sitio; consulta siempre a la Dirección del CETPRO por teléfono 323-3342 o por correo.</p>
  </div>
</article>
