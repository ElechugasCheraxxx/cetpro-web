  <div class="gallery">
    <figure class="gallery-item">
      <div class="parallax-wrap"><img class="parallax" src="/assets/img/culinary-kitchen.jpg" alt="Estudiantes de culinaria del CETPRO trabajando en una cocina profesional de formación (imagen de referencia, Pexels)" width="1125" height="750" loading="eager" decoding="async"></div>
      <figcaption class="card-caption">Taller de culinaria y cocina · cocina profesional en formación (Pexels)</figcaption>
    </figure>
    <figure class="gallery-item">
      <div class="parallax-wrap"><img class="parallax" src="/assets/img/sewing-class.jpg" alt="Estudiante del CETPRO usando una máquina de coser en la clase de textil y confección (imagen de referencia, Pexels)" width="1125" height="750" loading="eager" decoding="async"></div>
